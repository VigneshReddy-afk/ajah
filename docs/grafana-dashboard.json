      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(ajah_cost_usd_total[1h])) by (feature) * 3600",
          "legendFormat": "{{feature}}",
          "refId": "A"
        }
