          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.50, rate(ajah_scorer_latency_ms_bucket[5m]))",
          "legendFormat": "scorer p50",
          "refId": "B"
        }
      ],
      "title": "Scorer latency p50 and p95",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 7,
      "title": "Cost",
      "type": "row"
